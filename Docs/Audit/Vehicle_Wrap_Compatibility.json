  "semantics": {
    "choice": "Independent vehicleEnabled / vehicleChancePercent, same selected-only 30-finish catalog, deterministic existing hash with separate vehicle domain and persistent ID; no class replacement or extra production spawns.",
    "default_chance_percent": 100,
    "materials": "No SetObjectMaterial calls. Native materials, glass, lights, tires, seats and alpha-bearing textures remain under engine/publisher control.",
    "repaint_ownership": "A later player/Expansion/native damage repaint can override an applied wrap until a later load. The implementation does not fight that repaint or replace damage materials.",
    "restart": "Same selected finish set and persistent ID produce the same choice. Settings/catalog changes may alter selection. Disabling restores original next load; owned current textures can also be reset to their exact original, including blank.",
    "door_behavior": "Existing attached CarDoor-derived body panels with verified selections/model directory follow parent finish; detach restores exact original if still owned. No wheel/interior/cargo recoloring.",
    "report": "$profile:AzimuthSkins/vehicle_wrap_coverage.json aggregates observed server configuration candidates; eligibility is not proof of client rendering.",
    "cost": "Lifecycle/sync/attachment callbacks only; server waits at most120 bounded persistent-ID attempts; no world scan/per-frame hook.",
    "unsupported_behavior": "Original appearance; no guess based on generic camo name."
  },
